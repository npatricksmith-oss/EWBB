{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": ["WebSearch", "WebFetch"]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "failIfUnavailable": true,
    "credentials": {
      "files": [
        { "path": "~/.ssh", "mode": "deny" },
        { "path": "~/.gemini", "mode": "deny" },
        { "path": "~/.codex", "mode": "deny" }
      ]
    }
  }
}
