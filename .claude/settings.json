{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "WebSearch",
      "WebFetch"
    ],
    "deny": [
      "Edit(/.codex/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "failIfUnavailable": true,
    "credentials": {
      "files": [
        {
          "path": "~/.ssh",
          "mode": "deny"
        },
        {
          "path": "~/.gemini",
          "mode": "deny"
        },
        {
          "path": "~/.codex",
          "mode": "deny"
        }
      ]
    },
    "filesystem": {
      "denyWrite": [
        "/var/home/natex/Projects/EWBB/.codex"
      ]
    }
  }
}
